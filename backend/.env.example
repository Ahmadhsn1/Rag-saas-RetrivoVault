# This file is OPTIONAL for local dev — `npm run dev` boots with zero config
# (ephemeral in-memory MongoDB + demo mode). Fill it in for a real setup.

# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173          # used in email links + Stripe redirects
LOG_LEVEL=info

# --- Admin console ---
# The root administrator, provisioned at boot (or via `npm run seed:admin`).
# Set your own per deployment — nothing here ships with a default. The password
# is read once at startup and never logged; rotate it with `npm run seed:admin`.
ADMIN_EMAIL=
ADMIN_PASSWORD=                        # 12+ chars; required in production if ADMIN_EMAIL is set
ADMIN_NAME=Administrator
ADMIN_EMAILS=                          # comma-separated extra admins (promotes existing accounts)
PRESENCE_WINDOW_MIN=2                  # a session counts as "online" if seen within this many minutes

# --- Web Push (optional; broadcasts fall back to in-app + email without it) ---
# Generate a pair with `npm run seed:admin` (printed when unset) or the web-push CLI.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- MongoDB Atlas (Vector Search requires Atlas, not local mongod) ---
# Leave unset in dev to use an in-memory DB; set it for real vector search.
MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/retrivo_vault

# --- Auth ---
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Google Gemini ---
# Model names track Google's rolling aliases / current GA model on purpose —
# dated names (gemini-2.5-flash, text-embedding-004) get retired and 404. Pin
# only if you must. GEMINI_EMBEDDING_DIM must match your Atlas vector index.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
GEMINI_LLM_MODEL=gemini-flash-latest

# --- RAG tuning ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
VECTOR_INDEX_NAME=chunks_vector_index
INGEST_CONCURRENCY=2
MAX_CHUNKS_PER_DOC=4000
MAX_EXTRACTED_CHARS=5000000

# --- Uploads / queue ---
MAX_UPLOAD_MB=10
MAX_QUEUE_DEPTH=500

# --- Plans ---
TRIAL_DAYS=14

# --- Webhooks ---
WEBHOOK_ALLOW_PRIVATE=false            # true = allow private/loopback webhook URLs (dev only)

# --- Email (optional; without SMTP_URL, emails are logged to the console) ---
SMTP_URL=
MAIL_FROM=Retrivo Vault <no-reply@retrivo.local>

# --- Stripe billing (optional; without STRIPE_SECRET_KEY, billing is disabled
#     and everyone stays on the Free plan) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_MAX_MONTHLY=
STRIPE_PRICE_MAX_ANNUAL=

# --- Demo mode: auto-verify emails, skip real billing (for portfolio demos) ---
DEMO_MODE=false
