# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- MongoDB Atlas ---
# Must be an Atlas cluster (M0 free tier is fine) — Atlas Vector Search is required.
MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/retrivo_vault

# --- Auth ---
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_LLM_MODEL=gemini-2.5-flash

# --- RAG tuning ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
VECTOR_INDEX_NAME=chunks_vector_index

# --- Uploads ---
MAX_UPLOAD_MB=10
